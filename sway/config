# Modifier and directions
set $mod Mod4
set $left h
set $down j
set $up k
set $right l

# Keyboard layout
input type:keyboard {
    xkb_layout "us,ru"
    xkb_options grp:win_space_toggle
}

# Autostart
exec waybar
exec nm-applet --indicator
exec ~/.config/waybar/scripts/sunset.sh

exec gsettings set org.gnome.desktop.interface icon-theme Nordzy-dark
exec gsettings set org.gnome.desktop.interface cursor-theme Sunity-cursors
seat seat0 xcursor_theme Sunity-cursors 18

# Monitor
output HDMI-A-1 mode 1920x1080@60Hz position 1920,0

# Borders and colours
default_border pixel 3
default_floating_border pixel 3
hide_edge_borders smart

# Floating drag
floating_modifier $mod normal
mouse_warping container

# Additional configs
include ~/.config/sway/mapping.conf
include ~/.config/sway/workspace.conf
include ~/.config/sway/rules.conf
include /etc/sway/config.d/*
